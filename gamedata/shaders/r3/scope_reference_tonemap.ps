#include "scope_common.h"
Texture2D scope_reference_ocular;
float4 scope_reference_transfer;
struct ScopeReferenceToneMapped
{
    float4 low : SV_Target0;
    float4 high : SV_Target1;
};
ScopeReferenceToneMapped main(v_out input)
{
    ScopeReferenceToneMapped output;
    float3 raw = scope_reference_ocular.Load(int3(input.hpos.xy, 0)).rgb;
    float3 toneInput = pow(max(raw, 0), 1.0 / scope_reference_transfer.x);
    tonemap(output.low, output.high, toneInput, s_tonemap.Load(int3(0, 0, 0)).x);
    output.low.a = 1;
    output.high.a = 1;
    return output;
}
