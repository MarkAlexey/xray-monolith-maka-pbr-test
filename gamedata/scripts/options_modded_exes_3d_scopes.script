--- Zoom options tree
-- Page id stays "3d_scopes" so existing string ids and saved menu state keep working.

-- Import smart constructors
options_builder.import_into(this)

PAGE = page {
	{ id = "3d_scopes" },

	check {
		id = "new_zoom_enable",
		def = true
	},
	list_bool { id = "new_zoom_delta_algorithm" },
	track {
		id = "zoom_step_count",
		def = 3,
		step = 1,
	},
}
