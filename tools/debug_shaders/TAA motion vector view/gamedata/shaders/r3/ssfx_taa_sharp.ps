//////////////////////////////////////////////////////////////////////////////////////////
// Monolith debug: SSS TAA motion-vector view (TEMPORARY - remove after testing)
//
// Replaces SSS TAA's last pass (sharpening, ssfx_taa_sharp.ps) with a picture of the
// motion-vector buffer, so you can see which surfaces write motion vectors and which do not.
// The engine already binds the motion-vector buffer to this pass (blender_smaa.cpp, "Debug").
//
// Install: as a mod ABOVE everything else, enable SSS TAA (MCM), delete the shader cache.
// Remove it afterwards: while installed there is no TAA sharpening and you see debug colours.
//
// Reading it (DEBUG_MODE 1):
//   - Stand still: everything should be black (no motion).
//   - Turn the camera slowly: the whole world should light up smoothly in red/green
//     (red = horizontal motion, green = vertical, brighter = faster).
//   - Anything that stays BLACK while the camera turns does not write motion vectors.
//     TAA then reprojects it with the wrong motion and it smears/ghosts. Note what it is:
//     PBR objects only, all objects using one shader (terrain, trees, decals...), the sky...
//   - Blue = pixels flagged as HUD (weapon, hands). Without blue on the weapon, the HUD
//     shaders lost their motion-vector output.
//   - Wildly flickering colours on a still camera = the previous-frame matrices are wrong.
// DEBUG_MODE 2 draws the same over the dimmed image (easier to tell what is what).
// DEBUG_MODE 0 shows the TAA result without sharpening.
//
// Caveat: works only with SSS's motion-vector main file installed and TAA on (the pass does
// not run otherwise). Motion vectors are in screen-UV units; MV_SCALE sets the brightness.
//////////////////////////////////////////////////////////////////////////////////////////

#include "common.h"

// ----------------------------------------- settings -----------------------------------
#define DEBUG_MODE	1		// 0 = TAA image, 1 = motion vectors, 2 = motion vectors over the image
#define MV_SCALE	60.0	// brightness of the motion colours
// --------------------------------------------------------------------------------------

float4 taa_setup;

Texture2D s_motion_vectors;
Texture2D s_current;
sampler smp_point;

float4 main( p_screen I ) : SV_Target
{
	float3 img	= s_current.Sample( smp_point, I.tc0.xy ).xyz;
	float4 mv	= s_motion_vectors.Sample( smp_point, I.tc0.xy );	// xy = motion, z = HUD flag, w = TAA mask

	float3 vis	= float3( saturate( abs( mv.xy ) * MV_SCALE ), saturate( mv.z ) * 0.6 );

#if DEBUG_MODE == 0
	return float4( img, 1.0 );
#elif DEBUG_MODE == 1
	return float4( vis, 1.0 );
#else
	return float4( img * 0.35 + vis, 1.0 );
#endif
}
